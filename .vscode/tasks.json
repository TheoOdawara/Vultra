{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs: serve",
      "type": "shell",
      "command": "uvx zensical serve --open",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: serve",
      "type": "shell",
      "command": "uv run fastapi dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: gates",
      "type": "shell",
      "command": "uv run ruff check && uv run ruff format --check && uv run mypy && uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "problemMatcher": []
    },
    {
      "label": "pipeline: gates",
      "type": "shell",
      "command": "uv run ruff check && uv run ruff format --check && uv run mypy",
      "options": {
        "cwd": "${workspaceFolder}/packages/pipeline"
      },
      "problemMatcher": []
    }
  ]
}
