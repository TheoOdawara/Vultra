# =============================================================================
# VULTRA — Variáveis de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para `.env` na raiz do projeto (ou em infra/) e ajuste
# os valores antes de subir os containers.
#
#   cp infra/.env.example infra/.env
#
# ATENÇÃO: Nunca comite o arquivo `.env` real no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=vultra
POSTGRES_PASSWORD=vultra_secret
POSTGRES_DB=vultra_dev
POSTGRES_PORT=YOUR_PORT

# DATABASE_URL usada pelo drizzle-kit e pelo api-core (apps/api-core/.env)
# Em container-to-container: trocar "localhost" por "postgres"
DATABASE_URL=postgresql://vultra:vultra_secret@localhost:5432/vultra_dev

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=redis_secret
REDIS_PORT=YOUR_PORT

# REDIS_URL usada pelo api-core e ai-service
# Em container-to-container: trocar "localhost" por "redis"
REDIS_URL=redis://:redis_secret@localhost:6379
