# =============================================================================
# VULTRA — Variáveis de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para `.env` na pasta infra/ e ajuste os valores antes de
# subir os containers:
#
#   cp infra/.env.example infra/.env
#
# ATENÇÃO: Nunca comite o arquivo `.env` real no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=vultra
POSTGRES_PASSWORD=change_me_postgres_secret
POSTGRES_DB=vultra_db
# Porta exposta no host (padrão 5432 — altere se já tiver outro PG rodando)
POSTGRES_PORT=5432

# DATABASE_URL usada pelo drizzle-kit e pelo api-core (apps/api-core/.env)
# Em container-to-container o api-core usa o hostname "postgres" automaticamente.
# Use este valor apenas para conexões diretas do host (drizzle-kit, etc.):
DATABASE_URL=postgresql://vultra:change_me_postgres_secret@localhost:5432/vultra_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_secret
# Porta exposta no host (padrão 6379)
REDIS_PORT=6379

# REDIS_URL para conexões diretas do host (ex.: redis-cli local):
REDIS_URL=redis://:change_me_redis_secret@localhost:6379

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
# Porta exposta no host (padrão 8000)
AI_SERVICE_PORT=8000

# -----------------------------------------------------------------------------
# API Core (Bun + ElysiaJS)
# -----------------------------------------------------------------------------
# Porta exposta no host (padrão 3000)
API_CORE_PORT=3000

# Better Auth — gere o secret com: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_min_32_chars_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# CSV das origens permitidas no CORS e no trustedOrigins do Better Auth.
# Em produção, substitua pelos domínios reais dos frontends.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
