# =============================================================================
# VULTRA — api-core (.env.example)
# =============================================================================
# Copie este arquivo para `.env` e ajuste os valores antes de iniciar o serviço.
#
#   cp apps/api-core/.env.example apps/api-core/.env
#
# ATENÇÃO: Nunca comite o arquivo `.env` real no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL — drizzle-kit + database client
# Em container-to-container: trocar "localhost" por "postgres"
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://vultra:YOUR_DB_PASSWORD@localhost:5432/vultra_dev

# -----------------------------------------------------------------------------
# Better Auth
# Gerar secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# CSV das origens permitidas no CORS e no trustedOrigins do Better Auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# -----------------------------------------------------------------------------
# Redis — fila api-core ↔ ai-service
# Em container-to-container: trocar "localhost" por "redis"
# -----------------------------------------------------------------------------
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379

# -----------------------------------------------------------------------------
# Fila de reconhecimento — precisa ser idêntica à do ai-service, senão os dois
# lados falam em chaves diferentes e nenhum job é consumido
# -----------------------------------------------------------------------------
AI_QUEUE_NAME=ai:recognition:queue
AI_RESULT_PREFIX=ai:recognition:result:
